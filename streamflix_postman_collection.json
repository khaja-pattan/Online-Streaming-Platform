{
  "info": {
    "_postman_id": "streamflix-microservices-api-collection",
    "name": "StreamFlix — Movie Trailer Platform Microservices API",
    "description": "Comprehensive Postman collection for testing the StreamFlix Java Spring Boot Microservices architecture through the API Gateway (port 8080).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "jwtToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication & Users",
      "item": [
        {
          "name": "Login as Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usernameOrEmail\": \"admin\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Login as Demo User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usernameOrEmail\": \"john_doe\",\n  \"password\": \"User@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Register New User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"sarah_connor\",\n  \"email\": \"sarah@example.com\",\n  \"password\": \"Secret@123\",\n  \"role\": \"ROLE_USER\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Get Current User Profile (/api/users/me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Movie Catalog",
      "item": [
        {
          "name": "Get All Movies (Paginated)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/movies?page=0&size=20&sortBy=rating&sortDir=desc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "movies"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" },
                { "key": "sortBy", "value": "rating" },
                { "key": "sortDir", "value": "desc" }
              ]
            }
          }
        },
        {
          "name": "Get Movie by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/movies/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "movies", "1"]
            }
          }
        },
        {
          "name": "Search Movies by Keyword",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/movies/search?keyword=Dune",
              "host": ["{{baseUrl}}"],
              "path": ["api", "movies", "search"],
              "query": [
                { "key": "keyword", "value": "Dune" }
              ]
            }
          }
        },
        {
          "name": "Get Trending Movies",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/movies/trending",
              "host": ["{{baseUrl}}"],
              "path": ["api", "movies", "trending"]
            }
          }
        },
        {
          "name": "Create Movie Trailer (ADMIN Only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Interstellar\",\n  \"description\": \"A team of explorers travel through a wormhole in space in an attempt to ensure humanity's survival.\",\n  \"releaseDate\": \"2014-11-07\",\n  \"genre\": \"Sci-Fi, Adventure, Drama\",\n  \"posterUrl\": \"https://image.tmdb.org/t/p/w500/gEU2QniE6E77NI6lCU6MxlNBvIx.jpg\",\n  \"backdropUrl\": \"https://image.tmdb.org/t/p/original/rAiYTsqBkRefBXwe5nh8ivY0Y09.jpg\",\n  \"officialTrailerUrl\": \"https://www.youtube.com/watch?v=zSWdZVtXT7E\",\n  \"director\": \"Christopher Nolan\",\n  \"cast\": \"Matthew McConaughey, Anne Hathaway, Jessica Chastain\",\n  \"runtime\": 169,\n  \"contentRating\": \"PG-13\",\n  \"rating\": 8.7,\n  \"featured\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/movies",
              "host": ["{{baseUrl}}"],
              "path": ["api", "movies"]
            }
          }
        },
        {
          "name": "Delete Movie (ADMIN Only)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/movies/16",
              "host": ["{{baseUrl}}"],
              "path": ["api", "movies", "16"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Watchlist",
      "item": [
        {
          "name": "Get User Watchlist",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/watchlist",
              "host": ["{{baseUrl}}"],
              "path": ["api", "watchlist"]
            }
          }
        },
        {
          "name": "Add Movie to Watchlist",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/watchlist/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "watchlist", "1"]
            }
          }
        },
        {
          "name": "Remove Movie from Watchlist",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/watchlist/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "watchlist", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Recommendations",
      "item": [
        {
          "name": "Get Personalized Recommendations",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/recommendations",
              "host": ["{{baseUrl}}"],
              "path": ["api", "recommendations"]
            }
          }
        }
      ]
    }
  ]
}
